# cp .env.example .env — docker compose читає його; ті самі значення є типовими в compose.yaml.
NGINX_PORT=8080
APP_A_PORT=8001
APP_B_PORT=8002
API_PORT=8000
POSTGRES_PORT=5432
PG_MAX_CONNECTIONS=100
POOL_SIZE=10
WEB_CLIENT_ORIGIN=http://localhost:8081
DPC_CLIENT_ORIGIN=http://localhost:8083
API_TOKEN=dev-token

# DPC, ЛР1: місткість черги, кількість обробників, режим захисту ресурсу (locked | unprotected)
QUEUE_CAPACITY=50
WORKERS=4
RESOURCE_MODE=locked
# DPC, ЛР2: найбільша кількість процесів розрахунку й ядер контейнера
COMPUTE_PROCESSES=4
DPC_CPUS=4

MIGRATE_TO=
APP_TAG=dev
